CHECK,FPGA_RELEASE_SAME_FRAME,PASS

CHECK,SPI_SOFTWARE_40_TRANSACTIONS,PASS

CHECK,FPGA_SPI_BIST_REJECT,PASS

DATA,FPGA_SPI_BIST_REJECT,frame=1,ux=46831,uy=-171729,residual=590912626,valid=0,reason=3,angle_q8=0,servo_valid=0,cycles=0,us=40000

CHECK,FPGA_IRQ_AFTER_CONSUME,PASS

CHECK,FPGA_IRQ_EXTI_EDGES,PASS

CHECK,FPGA_IRQ_WHILE_LOCKED,PASS

DATA,FPGA_SPI_BIST_PASS,transfers=40,status=0

CHECK,FPGA_RELEASE_SAME_FRAME,PASS

CHECK,SPI_SOFTWARE_40_TRANSACTIONS,PASS

CHECK,FPGA_SPI_BIST_PASS,PASS

DATA,FPGA_SPI_BIST_PASS,frame=2,ux=749295,uy=0,residual=0,valid=1,reason=0,angle_q8=0,servo_valid=0,cycles=0,us=40000

CHECK,FPGA_IRQ_AFTER_CONSUME,PASS

CHECK,FPGA_IRQ_EXTI_EDGES,PASS

DATA,TIMEOUT_TEST,kind=SOFTWARE_INJECT_BEFORE_CS,not_physical_bus_timeout

CHECK,INJECTED_TIMEOUT_ISOLATION,PASS

CHECK,FPGA_EXPLICIT_RECOVERY,PASS

CHECK,FPGA_AFTER_RECOVERY_BIST,PASS

DATA,SAFETY,act=0,watchdog=0,fault=0x00000000

CHECK,FPGA_MOTION_DISABLED,PASS

CHECK,FPGA_NO_UNEXPECTED_FAULT,PASS

CHECK,SPI_PHYSICAL_WAVEFORM,SKIP,REQUIRES_SCOPE_OR_LOGIC_ANALYZER_1MHz_40CLOCKS_CS_SETUP_HOLD

CHECK,PHYSICAL_BUS_STALL_TIMEOUT,SKIP,SOFTWARE_INJECTION_IS_NOT_ELECTRICAL_STALL_TEST

CHECK,REAL_STREAM_QUEUE,SKIP,RUN_stream_COMMAND_WITH_READY_REAL_SOURCE

CHECK,ACTUAL_PWM_MOVEMENT,SKIP,INTENTIONALLY_DISABLED

SUMMARY,scope=FPGA_DIAGNOSTIC,pass=29,fail=0,skip=4,result=PASS_WITH_SKIPS,NOT_SYSTEM_ACCEPTANCE

COMMANDS,board / fpga / stream (send CRLF); reset boots BOARD_ONLY

