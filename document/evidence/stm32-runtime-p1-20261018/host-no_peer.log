COMMAND: F:\NUEC\SoundSight-stm32\software\stm32\build\host\selftest.exe no_peer
HOST_MODEL_ONLY,NOT_BOARD_MEASUREMENT


SELFTEST,BEGIN,mode=FPGA,motion_submission=DISABLED

CLOCK,sys=128000000,hclk=128000000,pclk1=32000000,pclk2=64000000,spi_calc=1000000

CHECK,CLOCK_128_32_64,PASS

CHECK,TIM2_1US_COUNTER,PASS

TIMEBASE,hal_ms=50,tim2_us=50000,dwt_cycles=6400000

CHECK,HAL_MILLISECOND_TICK,PASS

CHECK,DWT_COUNTER,PASS

CHECK,SPI_GPIO_CONFIGURATION,PASS

REG,SPI1_CR1=0x00000000,CR2=0x00000000,GPIOB_MODER=0x00000000,GPIOG_MODER=0x00000000

CHECK,CS_FLASH_SAFE_HIGH,PASS

CHECK,S2_CONTEXT_INIT,PASS

CHECK,ACTUATOR_WRITE_BLOCKED,PASS

CHECK,MOTION_PERMIT_BLOCKED,PASS

CHECK,S1_BOARD_BIST_REJECT,PASS

DATA,S1_REJECT,frame=1,ux=46831,uy=-171729,residual=590912626,valid=0,reason=3,angle_q8=0,servo_valid=0,cycles=0,us=0

PERF,S1_REJECT,runs=32,min_cycles=0,max_cycles=0,clock_hz=128000000

CHECK,S1_BOARD_BIST_PASS,PASS

DATA,S1_PASS,frame=1,ux=749295,uy=0,residual=0,valid=1,reason=0,angle_q8=0,servo_valid=0,cycles=0,us=0

PERF,S1_PASS,runs=32,min_cycles=0,max_cycles=0,clock_hz=128000000

DATA,FPGA_ID_ABI,status=7,id=0x00000000,abi=0x00000000

CHECK,FPGA_ID_ABI,FAIL

CHECK,FPGA_SPI_BIST_REJECT,SKIP,ID_ABI_FAILED

CHECK,FPGA_SPI_BIST_PASS,SKIP,ID_ABI_FAILED

CHECK,FPGA_RELEASE_CONSUME,SKIP,ID_ABI_FAILED

CHECK,FPGA_IRQ_LEVEL_EDGE,SKIP,ID_ABI_FAILED

CHECK,FPGA_TIMEOUT_RECOVERY,SKIP,ID_ABI_FAILED

CHECK,FPGA_MOTION_DISABLED,SKIP,ID_ABI_FAILED

CHECK,SPI_PHYSICAL_WAVEFORM,SKIP,REQUIRES_SCOPE_OR_LOGIC_ANALYZER_1MHz_40CLOCKS_CS_SETUP_HOLD

CHECK,PHYSICAL_BUS_STALL_TIMEOUT,SKIP,SOFTWARE_INJECTION_IS_NOT_ELECTRICAL_STALL_TEST

CHECK,REAL_STREAM_QUEUE,SKIP,RUN_stream_COMMAND_WITH_READY_REAL_SOURCE

CHECK,ACTUAL_PWM_MOVEMENT,SKIP,INTENTIONALLY_DISABLED

SUMMARY,scope=FPGA_DIAGNOSTIC,pass=11,fail=1,skip=10,result=FAIL,NOT_SYSTEM_ACCEPTANCE

COMMANDS,board / fpga / stream (send CRLF); reset boots BOARD_ONLY

HOST_MODEL,physical_model_transfers=1,forbidden_writes=0,checks=1,failures=0
