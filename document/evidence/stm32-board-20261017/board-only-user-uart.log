SoundSight STM32 boot
SYSCLK = 128000000 Hz
HCLK   = 128000000 Hz
PCLK1  = 32000000 Hz
PCLK2  = 64000000 Hz
BOOT,clock_init=0,board_init=1

SELFTEST,BEGIN,mode=BOARD_ONLY,motion_submission=DISABLED
CLOCK,sys=128000000,hclk=128000000,pclk1=32000000,pclk2=64000000,spi_calc=1000000
CHECK,CLOCK_128_32_64,PASS
CHECK,TIM2_1US_COUNTER,PASS
TIMEBASE,hal_ms=50,tim2_us=50001,dwt_cycles=6400033
CHECK,HAL_MILLISECOND_TICK,PASS
CHECK,DWT_COUNTER,PASS
CHECK,SPI_GPIO_CONFIGURATION,PASS
REG,SPI1_CR1=0x0000036C,CR2=0x00000000,GPIOB_MODER=0x10000A80,GPIOG_MODER=0x00004000
CHECK,CS_FLASH_SAFE_HIGH,PASS
CHECK,S2_CONTEXT_INIT,PASS
CHECK,ACTUATOR_WRITE_BLOCKED,PASS
CHECK,MOTION_PERMIT_BLOCKED,PASS
CHECK,S1_BOARD_BIST_REJECT,PASS
DATA,S1_REJECT,frame=1,ux=46831,uy=-171729,residual=590912626,valid=0,reason=3,angle_q8=0,servo_valid=0,cycles=87549,us=685
PERF,S1_REJECT,runs=32,min_cycles=87549,max_cycles=87619,clock_hz=128000000
CHECK,S1_BOARD_BIST_PASS,PASS
DATA,S1_PASS,frame=1,ux=749295,uy=0,residual=0,valid=1,reason=0,angle_q8=0,servo_valid=0,cycles=93245,us=729
PERF,S1_PASS,runs=32,min_cycles=93245,max_cycles=93321,clock_hz=128000000
CHECK,FPGA_ID_ABI,SKIP,FPGA_NOT_REQUESTED_OR_CONNECTED
CHECK,FPGA_SPI_BIST_REJECT,SKIP,FPGA_NOT_REQUESTED_OR_CONNECTED
CHECK,FPGA_SPI_BIST_PASS,SKIP,FPGA_NOT_REQUESTED_OR_CONNECTED
CHECK,FPGA_RELEASE_CONSUME,SKIP,FPGA_NOT_REQUESTED_OR_CONNECTED
CHECK,FPGA_IRQ_LEVEL_EDGE,SKIP,FPGA_NOT_REQUESTED_OR_CONNECTED
CHECK,FPGA_TIMEOUT_RECOVERY,SKIP,FPGA_NOT_REQUESTED_OR_CONNECTED
CHECK,FPGA_MOTION_DISABLED,SKIP,FPGA_NOT_REQUESTED_OR_CONNECTED
CHECK,SPI_PHYSICAL_WAVEFORM,SKIP,REQUIRES_SCOPE_OR_LOGIC_ANALYZER_1MHz_40CLOCKS_CS_SETUP_HOLD
CHECK,PHYSICAL_BUS_STALL_TIMEOUT,SKIP,SOFTWARE_INJECTION_IS_NOT_ELECTRICAL_STALL_TEST
CHECK,REAL_STREAM_QUEUE,SKIP,RUN_stream_COMMAND_WITH_READY_REAL_SOURCE
CHECK,ACTUAL_PWM_MOVEMENT,SKIP,INTENTIONALLY_DISABLED
SUMMARY,scope=BOARD_ONLY,pass=11,fail=0,skip=11,result=PASS_WITH_SKIPS,NOT_SYSTEM_ACCEPTANCE
COMMANDS,board / fpga / stream (send CRLF); reset boots BOARD_ONLY
