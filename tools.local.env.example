# Copy to tools.local.env (Git ignored); fill only the tools absent from PATH.
# KEY=value; no quotes, no shell commands or variable expansion.
# VIVADO_ROOT: Vivado installation directory containing bin/ (version 2025.2).
# PYTHON_EXE: full path to a working Python 3 executable.
# GCC_ROOT: MinGW-w64 installation directory containing bin/gcc.exe.
# SS_GCC: optional full gcc executable path, instead of GCC_ROOT.
VIVADO_ROOT=
PYTHON_EXE=
GCC_ROOT=
SS_GCC=
